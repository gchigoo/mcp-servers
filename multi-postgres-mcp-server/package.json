{
  "name": "multi-postgres-mcp-server",
  "version": "0.1.3",
  "description": "MCP server for interacting with multiple PostgreSQL databases",
  "license": "MIT",
  "author": "Gchigoo",
  "homepage": "https://github.com/gchigoo/mcp-servers",
  "bugs": "https://github.com/gchigoo/mcp-servers/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "database",
    "multi-database",
    "read-only"
  ],
  "type": "module",
  "bin": {
